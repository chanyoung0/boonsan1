<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="db.UnderwritingHistoryMapper">

    <resultMap id="UnderwritingHistoryResult" type="UnderwritingHistory">
        <id     property="historyId"                   column="history_id"/>
        <result property="residentRegistrationNumber"  column="resident_registration_number"/>
        <result property="name"                        column="name"/>
        <result property="age"                         column="age"/>
        <result property="gender"                      column="gender"
                javaType="enums.Gender"/>
        <result property="occupation"                  column="occupation"/>
        <result property="annualIncome"                column="annual_income"/>
        <result property="inquiredAt"                  column="inquired_at"/>
        <result property="vehicleModel"                column="vehicle_model"/>
        <result property="vehicleNumber"               column="vehicle_number"/>
        <result property="BMI"                         column="bmi"/>
        <result property="pastMedicalHistory"          column="past_medical_history"/>
        <result property="medicated"                   column="is_medicated"/>
        <result property="surgeryHistory"              column="surgery_history"/>
        <result property="familyHistory"               column="family_history"/>
        <result property="smoker"                      column="is_smoker"/>
        <result property="alcoholConsumption"          column="alcohol_consumption"/>
    </resultMap>

    <sql id="columns">
        history_id, resident_registration_number, name, age, gender, occupation,
        annual_income, inquired_at, vehicle_model, vehicle_number, bmi,
        past_medical_history, is_medicated, surgery_history, family_history,
        is_smoker, alcohol_consumption
    </sql>

    <select id="findById" parameterType="string" resultMap="UnderwritingHistoryResult">
        SELECT <include refid="columns"/>
        FROM underwriting_history
        WHERE history_id = #{historyId}
    </select>

    <select id="findByInsuredPerson" parameterType="string" resultMap="UnderwritingHistoryResult">
        SELECT <include refid="columns"/>
        FROM underwriting_history
        WHERE resident_registration_number = #{residentRegistrationNumber}
        ORDER BY inquired_at DESC
    </select>

    <insert id="insert" parameterType="UnderwritingHistory">
        INSERT INTO underwriting_history (
            history_id, resident_registration_number, name, age, gender, occupation,
            annual_income, inquired_at, vehicle_model, vehicle_number, bmi,
            past_medical_history, is_medicated, surgery_history, family_history,
            is_smoker, alcohol_consumption
        ) VALUES (
            #{historyId}, #{residentRegistrationNumber}, #{name}, #{age}, #{gender},
            #{occupation}, #{annualIncome}, #{inquiredAt}, #{vehicleModel}, #{vehicleNumber},
            #{BMI}, #{pastMedicalHistory}, #{medicated}, #{surgeryHistory}, #{familyHistory},
            #{smoker}, #{alcoholConsumption}
        )
    </insert>

</mapper>
