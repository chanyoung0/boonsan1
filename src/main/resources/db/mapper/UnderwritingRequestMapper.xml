<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="db.UnderwritingRequestMapper">

    <resultMap id="UnderwritingRequestResult" type="UnderwritingRequest">
        <id     property="requestId"            column="request_id"/>
        <result property="underwritingId"       column="underwriting_id"/>
        <result property="appliedAt"            column="applied_at"/>
        <result property="appliedId"            column="applied_id"/>
        <result property="rejectionReason"      column="rejection_reason"
                javaType="enums.RejectionReason"/>
        <result property="requestReason"        column="request_reason"
                javaType="enums.RequestReason"/>
        <result property="requestStatus"        column="request_status"
                javaType="enums.RequestStatus"/>
        <result property="surchargeCondition"   column="surcharge_condition"
                javaType="enums.SurchargeCondition"/>
        <result property="underwritingResult"   column="underwriting_result"
                javaType="enums.UnderwritingResultType"/>
        <result property="underwritingType"     column="underwriting_type"
                javaType="enums.UnderwritingType"/>
    </resultMap>

    <sql id="columns">
        request_id, underwriting_id, applied_at, applied_id, rejection_reason,
        request_reason, request_status, surcharge_condition, underwriting_result,
        underwriting_type
    </sql>

    <select id="findById" parameterType="string" resultMap="UnderwritingRequestResult">
        SELECT <include refid="columns"/>
        FROM underwriting_request
        WHERE request_id = #{requestId}
    </select>

    <select id="findAll" resultMap="UnderwritingRequestResult">
        SELECT <include refid="columns"/>
        FROM underwriting_request
        ORDER BY applied_at DESC
    </select>

    <insert id="insert" parameterType="UnderwritingRequest">
        INSERT INTO underwriting_request (
            request_id, underwriting_id, applied_at, applied_id, rejection_reason,
            request_reason, request_status, surcharge_condition, underwriting_result,
            underwriting_type
        ) VALUES (
            #{requestId}, #{underwritingId}, #{appliedAt}, #{appliedId}, #{rejectionReason},
            #{requestReason}, #{requestStatus}, #{surchargeCondition}, #{underwritingResult},
            #{underwritingType}
        )
    </insert>

</mapper>
